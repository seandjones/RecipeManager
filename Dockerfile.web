FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["RecipeManager.Web/RecipeManager.Web.csproj", "RecipeManager.Web/"]
COPY ["RecipeManager.ServiceDefaults/RecipeManager.ServiceDefaults.csproj", "RecipeManager.ServiceDefaults/"]
COPY ["Directory.Build.props", "."]

RUN dotnet restore "RecipeManager.Web/RecipeManager.Web.csproj"

COPY RecipeManager.Web/ RecipeManager.Web/
COPY RecipeManager.ServiceDefaults/ RecipeManager.ServiceDefaults/

RUN dotnet publish "RecipeManager.Web/RecipeManager.Web.csproj" \
    -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "RecipeManager.Web.dll"]
